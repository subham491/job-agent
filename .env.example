NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent?schema=public
# 32 random bytes, base64. Generate your own: openssl rand -base64 32
# Losing this key means saved site logins can no longer be decrypted.
VAULT_KEY=
# Naukri login. Plain text for now; moves into the vault once a Profile row exists.
NAUKRI_USERNAME=
NAUKRI_PASSWORD=
# Daily Naukri profile refresh, cron in India time. Runs at most once a day; leave empty to switch it off.
NAUKRI_REFRESH_CRON="0 9-21 * * *"
# Anthropic API key for the AI features (profile boost, AI order in the daily routine). Leave empty to switch AI off.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use. Default is claude-opus-5-5.
AI_MODEL=
